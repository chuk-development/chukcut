# Normalise line endings.
* text=auto eol=lf

*.rs      text diff=rust
*.wgsl    text
*.glsl    text
*.md      text diff=markdown
*.toml    text diff=toml

# Generated or vendored — keep them out of diffs and language statistics.
Cargo.lock linguist-generated=true -diff

# Binary, so git never tries to merge them.
*.png     binary
*.jpg     binary
*.ico     binary
*.icns    binary
*.woff2   binary
*.mp4     binary
*.wav     binary
